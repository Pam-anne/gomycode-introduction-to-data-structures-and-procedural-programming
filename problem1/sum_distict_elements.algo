ALGORITHM sum_distinct_elements
VAR
    set1 : ARRAY_OF INTEGER[4];
    set2 : ARRAY_OF INTEGER[5];
    sum : INTEGER := 0;
    i, j : INTEGER;
    found : BOOLEAN;
BEGIN
    set1 := {3, 1, 7, 9};
    set2 := {2, 4, 1, 9, 3};

    // Compare set1 elements against set2
    FOR i FROM 0 TO set1.length - 1 DO
        found := FALSE;
        FOR j FROM 0 TO set2.length - 1 DO
            IF (set1[i] = set2[j]) THEN
                found := TRUE;
                BREAK;
            END_IF
        END_FOR
        IF (NOT found) THEN
            sum := sum + set1[i];
        END_IF
    END_FOR

    // Compare set2 elements against set1
    FOR i FROM 0 TO set2.length - 1 DO
        found := FALSE;
        FOR j FROM 0 TO set1.length - 1 DO
            IF (set2[i] = set1[j]) THEN
                found := TRUE;
                BREAK;
            END_IF
        END_FOR
        IF (NOT found) THEN
            sum := sum + set2[i];
        END_IF
    END_FOR

    Write("Sum of distinct elements: ", sum);
END